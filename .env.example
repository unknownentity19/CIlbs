# ---------------------------------------------------------------------------
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Absolute origin used for canonical URLs, Open Graph, sitemap, and robots.
# Falls back to VERCEL_URL on previews and http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://cilbs.com

# Postgres. In production use Neon's *pooled* connection string (the one with
# `-pooler` in the host) so serverless instances don't exhaust the connection
# limit. Leave unset to run without a database: the studio still works from
# browser storage and accounts report that they're unavailable.
#   DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Session signing secret, 32+ characters. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# OAuth (optional). Each provider appears on the sign-in page only when both
# of its values are set, so leaving these blank simply hides the buttons.
#
# GitHub: Settings -> Developer settings -> OAuth Apps -> New OAuth App.
#   Homepage:            https://your-domain
#   Authorization callback: https://your-domain/api/auth/callback/github
#   (add a second app for http://localhost:3000 during development)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
#
# Google: console.cloud.google.com -> APIs & Services -> Credentials ->
# OAuth client ID (Web application).
#   Authorised redirect URI: https://your-domain/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Where error and event reports are POSTed. Unset means the app logs in
# development and does nothing in production.
# NEXT_PUBLIC_TELEMETRY_URL=https://collector.example.com/ingest
# TELEMETRY_URL=https://collector.example.com/ingest

# Stamped onto every report so you can tell releases apart (e.g. a git SHA).
# NEXT_PUBLIC_RELEASE=local
